<!DOCTYPE html>
<html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>下班工资计数器 · 设计图像素还原版</title>
<style>
:root{color-scheme:dark;font-family:Inter,"SF Pro Display","Microsoft YaHei", "PingFang SC",system-ui,sans-serif}
*{box-sizing:border-box}html,body{margin:0;min-width:0;min-height:100%;background:#131b30;color:white;overflow:hidden}body.electron{background:transparent}
#viewport{position:absolute;overflow:hidden}#stage{position:absolute;width:1254px;height:1254px;transform-origin:0 0;overflow:visible;user-select:none}
#art{position:absolute;inset:0;width:1254px;height:1254px;object-fit:contain;pointer-events:none}
#art-original{display:none;position:absolute;inset:0;width:1254px;height:1254px;pointer-events:none}
.live-overlay{position:absolute;inset:0;pointer-events:none}.dynamic{position:absolute;white-space:nowrap;font-variant-numeric:tabular-nums;font-family:Inter,"Segoe UI", "Microsoft YaHei", "PingFang SC",Arial,sans-serif;font-weight:550;line-height:1.12;text-shadow:0 2px 9px rgba(0,0,0,.25)}
.status{left:544px;top:200px;color:#90ffc1;font-size:24px;font-weight:600;letter-spacing:.6px}
.timer{left:226px;top:318px;font-size:101px;font-weight:610;letter-spacing:-4px;color:#f7f9ff;text-shadow:0 2px 10px #c8d4f233}
.meta{left:762px;font-size:20px;font-weight:490;color:#e5e7f4;letter-spacing:-.6px}.date{top:292px}.work{top:354px}.break{top:416px}
.percent{left:1018px;top:351px;width:122px;text-align:center;font-size:47px;font-weight:660;letter-spacing:-2px;color:#f6fafb}
.earned{left:427px;top:533px;font-size:67px;letter-spacing:-1.4px;font-weight:650;color:#ffe3a0;text-shadow:0 0 4px #fbc57565, 0 3px 7px #2b1b0d}
.daily{left:1014px;top:518px;width:145px;text-align:right;color:#f3f4fd;font-size:21px;font-weight:650}
.progress-val{left:1102px;top:572px;width:67px;text-align:right;font-size:22px;color:#f0f6ff;font-weight:620}
.stat{top:774px;font-size:26px;font-weight:610;color:#f6f7fc;text-shadow:0 2px 5px #0004}
.hourly{left:208px;width:139px;text-align:center}.worked{left:352px;width:156px;text-align:center}.remaining{left:521px;width:148px;text-align:center}
.chart-chip{left:1037px;top:692px;width:144px;font-size:17px;color:#e7fbf3;text-align:right;font-weight:550}
.month-count{left:435px;top:936px;width:68px;text-align:right;font-size:19px}.month-work{top:978px}.month-earned{top:1017px;left:365px;width:137px;text-align:right;font-size:21px;color:#ffe19b;font-weight:660}
.monthly-net{top:940px;left:714px;width:118px;text-align:right;font-size:21px;color:#ffe3a2;font-weight:660}.insurance{top:995px}
#plotCanvas{position:absolute;left:700px;top:720px;width:477px;height:125px;pointer-events:none;border-radius:3px}
#progressArc{position:absolute;left:963px;top:261px;width:204px;height:204px;pointer-events:none;transform:rotate(-90deg)}
#progressArc circle{fill:none;stroke-width:16;stroke-linecap:round;transition:stroke-dashoffset .25s linear}#progressArc #ring{stroke:#65f1ae;filter:drop-shadow(0 0 6px rgba(89,239,175,.35))}
#hotspots{position:absolute;inset:0;pointer-events:none}button.hotspot{pointer-events:auto;position:absolute;border:0;background:transparent;color:transparent;cursor:pointer;border-radius:14px;transition:background .2s;outline-offset:1px}
button.hotspot:hover{background:rgba(255,255,255,.055)}button.hotspot:focus-visible{outline:2px solid #80f8bb}
#gear{left:932px;top:184px;width:54px;height:56px}#pin{left:1006px;top:184px;width:53px;height:56px}#minus{left:1069px;top:184px;width:49px;height:56px}#quit{left:1137px;top:184px;width:52px;height:56px}
#salaryClick{left:193px;top:470px;width:1000px;height:190px}#monthClick{left:192px;top:869px;width:324px;height:194px}
#drag{position:absolute;left:181px;top:165px;width:742px;height:78px;pointer-events:auto;-webkit-app-region:drag;cursor:move}
body:not(.electron) #drag{display:none}
#referenceHint{position:absolute;left:235px;top:1100px;color:#c1cde1;font-size:13px;display:none;pointer-events:none}
.reference-mode .live-overlay{display:none}.reference-mode #art{display:none}.reference-mode #art-original{display:block}.reference-mode #referenceHint{display:none}.reference-mode #toast{display:none}
#toast{position:absolute;left:50%;top:1095px;transform:translateX(-50%) translateY(8px);opacity:0;transition:.2s;padding:10px 17px;border-radius:12px;background:#263751e9;border:1px solid #839eb84d;box-shadow:0 10px 20px #0006;font-size:16px;z-index:22;pointer-events:none}
#toast.on{opacity:1;transform:translateX(-50%) translateY(0)}
#modal{display:none;position:absolute;inset:157px 169px 160px 169px;z-index:12;background:rgba(8,16,30,.88);border:1px solid #8899b077;backdrop-filter:blur(28px);border-radius:50px;box-shadow:0 25px 80px #0009;overflow:hidden;pointer-events:auto}
#modal.show{display:flex;flex-direction:column}
.modal-head{padding:28px 38px 21px;border-bottom:1px solid #ffffff24;display:flex;align-items:center;justify-content:space-between}
.modal-head h2{font-size:32px;letter-spacing:-.3px;margin:0}.modal-head p{font-size:14px;color:#b2bed2;margin:6px 0 0}
.iconbtn{background:#ffffff10;color:white;border:1px solid #ffffff30;border-radius:14px;width:40px;height:40px;font-size:24px;cursor:pointer}
.modal-scroll{padding:25px 38px;overflow:auto;flex:1;scrollbar-color:#576b88 transparent;scrollbar-width:thin}
.settings-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:17px 22px}
fieldset{border:1px solid #ffffff20;border-radius:18px;padding:20px;margin:0 0 18px;background:#ffffff06}legend{font-size:19px;font-weight:650;color:#e7ebf5;padding:0 8px}
label.field{display:flex;flex-direction:column;gap:7px;font-size:15px;color:#c5d0e0}label.field input,label.field select,label.field textarea{background:#101b2b;border:1px solid #5b709054;border-radius:10px;color:#f8fbff;font-size:18px;font-family:inherit;padding:12px 13px;outline:0;min-width:0}
label.field input:focus,label.field select:focus,label.field textarea:focus{border-color:#70efb7;box-shadow:0 0 0 2px #70efb722}
label.field textarea{resize:vertical;min-height:70px;font-size:16px}.helper{color:#96a8c1;font-size:13px;line-height:1.5;margin:10px 0 0}.week-checks{display:flex;gap:9px;flex-wrap:wrap;padding:8px 0}.week-checks label{border:1px solid #72849a44;padding:9px 12px;border-radius:12px;font-size:14px;cursor:pointer;display:flex;gap:6px;align-items:center}
.modal-foot{padding:19px 30px;display:flex;align-items:center;justify-content:space-between;gap:8px;border-top:1px solid #ffffff26;background:#ffffff08}.foot-right{display:flex;gap:9px}
.action{padding:11px 17px;border:1px solid #ffffff25;background:#ffffff0f;color:#eef4ff;border-radius:12px;font-size:15px;cursor:pointer}.action:hover{background:#ffffff1b}.action.primary{background:#80efba;color:#10283b;border-color:#80efba;font-weight:700}.action.danger{color:#ffbabe}
#previewMode{position:fixed;left:12px;bottom:12px;z-index:99;font:12px system-ui;color:#c9d7eb;border:1px solid #ffffff35;border-radius:18px;padding:9px 12px;background:#182337d9;cursor:pointer}
body.electron #previewMode{display:none}#previewMode{display:none}


/* Mini mode intentionally reuses the same navy/glass palette as the reference; full mode keeps the source pixels intact. */
#miniPanel{display:none;position:absolute;inset:10px 11px 12px 11px;color:#f4f7fd;border:1px solid rgba(203,221,255,.48);border-radius:27px;background:linear-gradient(118deg,rgba(35,46,74,.98),rgba(12,22,45,.98) 65%,rgba(31,41,64,.96));box-shadow:0 18px 50px #020817b8,inset 0 0 27px #95b5f014;overflow:hidden;padding:17px 23px 16px 24px;isolation:isolate}
#miniPanel:before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 0 100%,#edaa7740,transparent 52%),radial-gradient(ellipse at 93% 0,#426b9150,transparent 63%);pointer-events:none}
#miniPanel:after{content:'';position:absolute;left:4%;right:4%;top:0;height:1px;background:linear-gradient(90deg,transparent,#ffdfb9,transparent);pointer-events:none}
body.compact #viewport{display:none}
body.compact #miniPanel{display:block}
.mini-head{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;height:26px;gap:12px}
.mini-brand{font-size:16px;font-weight:700;display:flex;gap:8px;align-items:center;letter-spacing:.2px}.mini-dot{width:7px;height:7px;background:#64f2aa;border-radius:50%;box-shadow:0 0 9px #4bf8a9}
.mini-status{font-size:12px;font-weight:600;color:#7becad}
.mini-controls{display:flex;gap:5px}.mini-controls button{color:#c9d3e7;background:transparent;border:0;padding:5px 7px;cursor:pointer;border-radius:8px;font-size:16px}.mini-controls button:hover{background:#ffffff20}
.mini-cat{position:absolute;right:63px;top:-14px;width:173px;height:auto;opacity:.96;pointer-events:none;z-index:0;mix-blend-mode:normal}
.mini-main{position:relative;z-index:1;display:grid;grid-template-columns: 1.05fr .95fr;gap:18px;margin-top:18px}
.mini-label{font-size:12px;color:#adbcd3;margin-bottom:6px}.mini-timer{font-size:30px;line-height:1;font-weight:660;letter-spacing:-.5px;font-variant-numeric:tabular-nums}
.mini-money{font-size:29px;line-height:1;font-weight:750;color:#ffe0a0;text-shadow:0 0 13px #d69e4a40;font-variant-numeric:tabular-nums}
.mini-track{height:5px;border-radius:10px;background:#50617c7d;overflow:hidden;margin-top:16px}.mini-track>span{display:block;height:100%;width:0;background:linear-gradient(90deg,#59d6d3,#6af5a6);border-radius:10px;transition:width .3s}
.mini-foot{position:relative;z-index:1;display:flex;justify-content:space-between;align-items:center;font-size:11px;color:#aab9cd;margin-top:11px}.mini-foot strong{color:#ccf9db;font-weight:600}
.mini-drag{-webkit-app-region:drag;cursor:move;position:absolute;inset:0 155px auto 0;height:49px;z-index:0}
#miniPanel button{-webkit-app-region:no-drag}
body:not(.electron).compact #miniPanel{position:relative;margin:8vh auto;width:min(560px,calc(100vw - 24px));height:204px}
body:not(.electron).compact{background:linear-gradient(128deg,#172139,#060e24)}


#detailPanel{display:none;position:absolute;inset:169px 179px 183px;z-index:13;background:linear-gradient(135deg,rgba(28,39,63,.985),rgba(8,17,34,.987));border:1px solid #a9c1d566;border-radius:37px;box-shadow:0 22px 80px #01050ec9,inset 0 2px #eec49d40;overflow:hidden;pointer-events:auto}
#detailPanel.show{display:flex;flex-direction:column}
.detail-head{display:flex;align-items:center;justify-content:space-between;padding:28px 35px;border-bottom:1px solid #becde125}
.detail-head h2{margin:0;font-size:30px;letter-spacing:-.5px}.detail-head p{font-size:14px;color:#a3b6cc;margin:6px 0 0}
.detail-body{padding:24px 35px;overflow:auto;scrollbar-color:#5d7192 transparent;flex:1}
.detail-overview{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:20px}
.detail-tile{background:linear-gradient(145deg,#ffffff14,#ffffff05);border:1px solid #a0b3d034;border-radius:14px;padding:14px 16px}
.detail-tile .tag{color:#a4b8ce;font-size:13px}.detail-tile .val{margin-top:7px;font-size:21px;font-weight:720;color:#ffe09d;font-variant-numeric:tabular-nums}
.detail-calendar{display:grid;grid-template-columns:repeat(7,1fr);gap:7px}
.detail-calendar .weekday-title{padding:9px 3px;font-size:13px;color:#abc0d4;text-align:center}
.detail-day{background:#ffffff0b;border:1px solid #ffffff16;border-radius:12px;min-height:71px;padding:9px;text-align:left;color:#ccd6e5;font-size:13px}
.detail-day.working{background:#6bf0ae0e;border-color:#76f8b328}.detail-day.today{outline:2px solid #6de7ae9e}.detail-day .amount{display:block;font-size:12px;color:#88e6b1;margin-top:12px;white-space:nowrap;font-variant-numeric:tabular-nums}
.detail-day.rest .amount{color:#8296aa}
.detail-note{font-size:13px;color:#9eb3ce;line-height:1.75;margin-top:14px}
.detail-formula{background:#101e33;border:1px solid #647d954d;border-radius:17px;padding:21px;font-size:17px;line-height:2;color:#dce8f5}.detail-formula strong{color:#ffe0a0}
.detail-close{background:#ffffff12;color:#fff;border:1px solid #ffffff30;border-radius:12px;width:40px;height:40px;font-size:23px;cursor:pointer}
</style></head>
<body><div id="viewport"><div id="stage">
<img id="art" alt="原设计图像素还原背景"><img id="art-original" alt="设计图未修改原稿"><div id="drag" title="拖动到桌面任意位置"></div>
<div class="live-overlay">
<div class="dynamic status" id="status">工作中</div><div class="dynamic timer" id="countdown">02:47:32</div>
<div class="dynamic meta date" id="date">2025/05/16</div><div class="dynamic meta work" id="workTime">08:30 - 17:30</div><div class="dynamic meta break" id="breakTime">12:00 - 13:30</div>
<svg id="progressArc" viewBox="0 0 204 204"><circle cx="102" cy="102" r="89" stroke="#536781" stroke-width="16" fill="none" opacity=".65" style="filter:none"/><circle id="ring" cx="102" cy="102" r="89" stroke-dasharray="559.2" stroke-dashoffset="207"/></svg><div class="dynamic percent" id="percent">63%</div>
<div class="dynamic earned" id="earned">¥126.438</div><div class="dynamic daily" id="daily">¥260.000</div><div class="dynamic progress-val" id="progress">63%</div>
<div class="dynamic stat hourly" id="hourly">¥32.500</div><div class="dynamic stat worked" id="worked">03:53:28</div><div class="dynamic stat remaining" id="remaining">02:47:32</div>
<canvas id="plotCanvas" width="954" height="250"></canvas><div class="dynamic chart-chip" id="chartChip">当前：¥126.438</div>
<div class="dynamic month-count" id="monthCount">12 天</div><div class="dynamic month-count month-work" id="monthWork">22 天</div><div class="dynamic month-earned" id="monthEarned">¥3,545.455</div>
<div class="dynamic monthly-net" id="monthlyNet">¥6,500.000</div><div class="dynamic monthly-net insurance" id="insurance">¥600.000</div>
</div>
<div id="hotspots"><button id="gear" class="hotspot" title="设置薪资、工时和假日" aria-label="设置"></button><button id="pin" class="hotspot" title="切换窗口置顶" aria-label="置顶"></button><button id="minus" class="hotspot" title="收起组件" aria-label="收起"></button><button id="quit" class="hotspot" title="隐藏到系统托盘" aria-label="关闭"></button><button id="salaryClick" class="hotspot" title="查看工资计算说明" aria-label="工资计算说明"></button><button id="monthClick" class="hotspot" title="查看本月统计" aria-label="本月统计"></button></div>
<div id="referenceHint">设计参考模式：原图完整显示，不叠加实时数据 · Alt + R 返回实时模式</div>
<div id="modal"><header class="modal-head"><div><h2>个性化设置</h2><p>工资和工时更新后，实时计数将自动重新计算</p></div><button id="dismiss" class="iconbtn" aria-label="关闭设置">×</button></header>
<div class="modal-scroll">
<fieldset><legend>薪资设置</legend><div class="settings-grid"><label class="field">月到手工资（元）<input type="number" id="setNet" min="0" max="10000000" step="0.001"></label><label class="field">五险一金（元，仅展示）<input type="number" id="setInsurance" min="0" max="10000000" step="0.001"></label><label class="field">日薪计算方式<select id="setMethod"><option value="month">按本月实际应出勤天数</option><option value="21.75">按 21.75 天折算</option></select></label><label class="field">时间区域<select id="setTimezone"><option value="Asia/Shanghai">中国标准时间（北京时间）</option><option value="local">跟随设备系统时区</option></select></label></div><p class="helper">默认“到手 ¥6,500”，五险一金 ¥600 单独展示，不再重复扣除。实时金额为按工作时间折算的估算，并非实际工资发放凭证。</p></fieldset>
<fieldset><legend>工作时段</legend><div class="settings-grid"><label class="field">上班时间<input type="time" id="setStart"></label><label class="field">下班时间<input type="time" id="setEnd"></label><label class="field">午休开始<input type="time" id="setLunchStart"></label><label class="field">午休结束<input type="time" id="setLunchEnd"></label></div><div style="margin-top:12px"><label style="display:flex;align-items:center;gap:10px;color:#d9e6f2;font-size:15px"><input id="setPaidLunch" type="checkbox"> 午休时间也计入工资累计</label></div></fieldset>
<fieldset><legend>工作日与节假日</legend><div class="week-checks" id="weekChecks"></div><p class="helper">内置 2026/2027 中国节假日及调休（来源以当地最新官方通知为准）。自定义日期优先级高于内置安排；未覆盖的年份按每周工作日计算。</p><div class="settings-grid" style="margin-top:14px"><label class="field">额外工作日（每行一个 YYYY-MM-DD）<textarea id="extraWork" spellcheck="false" placeholder="2028-01-08"></textarea></label><label class="field">额外休息日（每行一个 YYYY-MM-DD）<textarea id="extraOff" spellcheck="false" placeholder="2028-01-01"></textarea></label></div></fieldset>
<fieldset><legend>桌面行为</legend><div class="settings-grid"><label style="display:flex;align-items:center;gap:10px"><input id="setPinned" type="checkbox"> 始终置顶</label><label style="display:flex;align-items:center;gap:10px"><input id="setAutoStart" type="checkbox"> 登录时自动启动（仅桌面版）</label></div><p class="helper">设计图对照：在主界面按 Alt + R，可切换到未经修改的原始截图，用于检查静态像素一致性。</p></fieldset>
</div><footer class="modal-foot"><div class="foot-right"><button class="action" id="export">导出设置</button><button class="action" id="import">导入设置</button><input type="file" id="fileImport" accept="application/json,.json" hidden><button class="action danger" id="reset">重置</button></div><div class="foot-right"><button class="action" id="cancel">取消</button><button class="action primary" id="save">保存并应用</button></div></footer></div>
<div id="toast" role="status"></div>
<div id="detailPanel" role="dialog" aria-modal="true" aria-labelledby="detailTitle"><header class="detail-head"><div><h2 id="detailTitle">月度收入明细</h2><p id="detailSubtitle">自动识别工作日、节假日、调休与午休</p></div><button id="detailDismiss" class="detail-close" aria-label="关闭详情">×</button></header><div class="detail-body" id="detailBody"></div></div>

</div></div>
<div id="miniPanel" role="region" aria-label="下班工资计数器迷你组件">
  <div class="mini-drag" aria-hidden="true"></div>
  <img class="mini-cat" src="data:image/png;base64," alt="睡着的猫咪" />
  <div class="mini-head">
    <div class="mini-brand"><span>◷</span> 下班工资计数器 <span class="mini-dot"></span><span class="mini-status" id="miniStatus">工作中</span></div>
    <div class="mini-controls"><button id="miniPin" title="切换置顶">♧</button><button id="miniExpand" title="展开完整界面">⛶</button><button id="miniClose" title="隐藏窗口">×</button></div>
  </div>
  <div class="mini-main"><div><div class="mini-label">距离下班</div><div class="mini-timer" id="miniTimer">02:47:32</div></div><div><div class="mini-label">今日已经赚到</div><div class="mini-money" id="miniMoney">¥126.438</div></div></div>
  <div class="mini-track"><span id="miniBar"></span></div>
  <div class="mini-foot"><span>上班 08:30 · 下班 17:30</span><span>今日进度 <strong id="miniPct">63%</strong></span></div>
</div>
<button id="previewMode" title="对照原始设计图">对照原设计图 · Alt+R</button>
<script>
'use strict';
const $=x=>document.getElementById(x);
const DEFAULT={monthlyNet:6500,insurance:600,salaryMode:'month',start:'08:30',end:'17:30',lunchStart:'12:00',lunchEnd:'13:30',paidLunch:false,workDays:[1,2,3,4,5],extraWorkdays:[],extraHolidays:[],alwaysOnTop:true,autoStart:false,timezone:'Asia/Shanghai'};
const HOLIDAYS={
2026:'01-01 01-02 01-03 02-15 02-16 02-17 02-18 02-19 02-20 02-21 02-22 02-23 04-04 04-05 04-06 05-01 05-02 05-03 05-04 05-05 06-19 06-20 06-21 09-25 09-26 09-27 10-01 10-02 10-03 10-04 10-05 10-06 10-07',
2027:'01-01 01-02 01-03 02-05 02-06 02-07 02-08 02-09 02-10 02-11 02-12 02-13 04-03 04-04 04-05 05-01 05-02 05-03 05-04 05-05 06-09 09-15 10-01 10-02 10-03 10-04 10-05 10-06 10-07'
};
const MAKEUP={2026:'01-04 02-14 02-28 05-09 09-20 10-10',2027:'01-31 02-14 05-08 09-26 10-09'};
let cfg={...DEFAULT},last={};let exact=false;let compact=false;let toastTimer;
const numberMoney=n=>'¥'+Math.max(0,Number.isFinite(n)?n:0).toLocaleString('zh-CN',{minimumFractionDigits:3,maximumFractionDigits:3});
const pad=n=>String(n).padStart(2,'0');const toMin=s=>{let [h,m]=String(s).split(':').map(Number);return h*60+m};
const hms=v=>{v=Math.max(0,Math.floor(v));return `${pad(Math.floor(v/3600))}:${pad(Math.floor((v%3600)/60))}:${pad(v%60)}`};
function nowZoned(){const d=window.__demoClock?new Date(window.__demoClock):new Date();if(cfg.timezone==='local')return d;const parts=new Intl.DateTimeFormat('en-US',{timeZone:'Asia/Shanghai',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit',hourCycle:'h23'}).formatToParts(d);let obj={};for(const p of parts)obj[p.type]=p.value;return new Date(Number(obj.year),Number(obj.month)-1,Number(obj.day),Number(obj.hour),Number(obj.minute),Number(obj.second));}
function key(d){return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`}
function validDate(s){if(!/^\d{4}-\d\d-\d\d$/.test(s))return false;const d=new Date(s+'T00:00:00');return !isNaN(d.getTime())&&key(d)===s}
function listDate(s){return [...new Set(String(s).split(/[\s,，;；]+/).filter(validDate))].sort()}
function merge(o){let c={...DEFAULT,...(o||{})};c.monthlyNet=Math.max(0,Number(c.monthlyNet)||0);c.insurance=Math.max(0,Number(c.insurance)||0);c.workDays=Array.isArray(c.workDays)?c.workDays.filter(n=>Number.isInteger(n)&&n>=0&&n<=6):DEFAULT.workDays;c.extraHolidays=Array.isArray(c.extraHolidays)?c.extraHolidays.filter(validDate):[];c.extraWorkdays=Array.isArray(c.extraWorkdays)?c.extraWorkdays.filter(validDate):[];return c}
function special(d,collection){let y=d.getFullYear(),list=collection[y];return list&&list.split(' ').includes(`${pad(d.getMonth()+1)}-${pad(d.getDate())}`)}
function workday(d){let k=key(d);if(cfg.extraHolidays.includes(k))return false;if(cfg.extraWorkdays.includes(k))return true;if(special(d,MAKEUP))return true;if(special(d,HOLIDAYS))return false;return cfg.workDays.includes(d.getDay())}
function monthDays(d){let a=[];let y=d.getFullYear(),m=d.getMonth(),max=new Date(y,m+1,0).getDate();for(let n=1;n<=max;n++){let x=new Date(y,m,n);if(workday(x))a.push(x)}return a}
function secondsPerDay(){let s=toMin(cfg.start),e=toMin(cfg.end),a=toMin(cfg.lunchStart),b=toMin(cfg.lunchEnd);let lunch=cfg.paidLunch?0:Math.max(0,Math.min(e,b)-Math.max(s,a));return Math.max(1,(e-s-lunch)*60)}
function paidSinceStart(d){let s=toMin(cfg.start),e=toMin(cfg.end),a=toMin(cfg.lunchStart),b=toMin(cfg.lunchEnd),m=d.getHours()*60+d.getMinutes()+d.getSeconds()/60;let t=Math.max(0,Math.min(e,m)-s);if(!cfg.paidLunch)t-=Math.max(0,Math.min(e,m,b)-Math.max(s,a));return Math.max(0,Math.min(secondsPerDay(),t*60))}
function nextWork(d){for(let n=0;n<60;n++){let x=new Date(d.getFullYear(),d.getMonth(),d.getDate()+n);x.setHours(Math.floor(toMin(cfg.start)/60),toMin(cfg.start)%60,0,0);if(workday(x)&&x>d)return x;}return new Date(d.getTime()+86400000)}
function calc(now){let days=monthDays(now),daily=cfg.monthlyNet/(cfg.salaryMode==='21.75'?21.75:Math.max(1,days.length)),working=workday(now),sec=working?paidSinceStart(now):0,paidTotal=secondsPerDay(),ratio=Math.min(1,sec/paidTotal),earned=daily*ratio,completed=days.filter(d=>key(d)<key(now)).length,monthly=completed*daily+(working?earned:0),minute=now.getHours()*60+now.getMinutes()+now.getSeconds()/60,start=toMin(cfg.start),end=toMin(cfg.end),a=toMin(cfg.lunchStart),b=toMin(cfg.lunchEnd);let status='工作中',cd=0;if(!working){status='休息中';cd=Math.round((nextWork(now)-now)/1000)}else if(minute<start){status='未上班';cd=Math.round((nextWork(now)-now)/1000)}else if(minute>=end){status='已下班';cd=0}else{status=(minute>=a&&minute<b)?'午休中':'工作中';cd=Math.max(0,(end-minute)*60)}return {now,days,daily,working,sec,paidTotal,ratio,earned,completed,monthly,minute,status,cd,hourly:daily*3600/paidTotal}}
function updateRing(p){let c=2*Math.PI*89;$('ring').style.strokeDasharray=c;$('ring').style.strokeDashoffset=c*(1-p)}
function plot(info){const cn=$('plotCanvas'),ctx=cn.getContext('2d');ctx.clearRect(0,0,954,250);const W=954,H=250;const l=88,r=8,t=8,b=29;const gw=W-l-r,gh=H-t-b;const top=info.daily||1;const start=toMin(cfg.start),end=toMin(cfg.end),a=toMin(cfg.lunchStart),bb=toMin(cfg.lunchEnd);
const bg=ctx.createLinearGradient(0,0,0,H);bg.addColorStop(0,'rgba(22,33,54,1)');bg.addColorStop(1,'rgba(23,37,59,1)');ctx.fillStyle=bg;ctx.fillRect(0,0,W,H);
for(let i=0;i<=4;i++){let y=t+gh*i/4;ctx.strokeStyle='rgba(178,204,240,.17)';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(l,y);ctx.lineTo(W-r,y);ctx.stroke();ctx.font='21px "Segoe UI",Arial,sans-serif';ctx.fillStyle='#b6c4d7';ctx.textAlign='right';ctx.fillText((top*(1-i/4)).toFixed(3),l-12,y+5)}
for(let i=0;i<=5;i++){let x=l+gw*i/5;ctx.strokeStyle='#a8bbd01a';ctx.beginPath();ctx.moveTo(x,t);ctx.lineTo(x,t+gh);ctx.stroke();let m=Math.round(start+(end-start)*i/5);ctx.font='19px "Segoe UI",Arial,sans-serif';ctx.fillStyle='#d0d5e0';ctx.textAlign='center';ctx.fillText(`${pad(Math.floor(m/60))}:${pad(m%60)}`,x,H-2)}
const pts=[];for(let i=0;i<=160;i++){let mm=start+(end-start)*i/160;let paid=Math.max(0,Math.min(end,mm)-start);if(!cfg.paidLunch)paid-=Math.max(0,Math.min(end,mm,bb)-Math.max(start,a));let v=Math.max(0,Math.min(1,paid*60/info.paidTotal));pts.push({x:l+i*gw/160,y:t+gh*(1-v)})}
let idx=info.working?Math.max(0,Math.min(160,Math.floor((info.minute-start)/(end-start)*160))):0,cur=pts[idx];
ctx.beginPath();ctx.moveTo(l,t+gh);for(let i=0;i<=idx;i++)ctx.lineTo(pts[i].x,pts[i].y);ctx.lineTo(cur.x,t+gh);ctx.closePath();let grad=ctx.createLinearGradient(0,t,0,t+gh);grad.addColorStop(0,'rgba(89,241,180,.27)');grad.addColorStop(1,'rgba(89,241,180,.035)');ctx.fillStyle=grad;ctx.fill();
ctx.beginPath();pts.slice(0,idx+1).forEach((p,i)=>i?ctx.lineTo(p.x,p.y):ctx.moveTo(p.x,p.y));ctx.lineWidth=3;ctx.strokeStyle='#78f2bc';ctx.shadowColor='#2dfaab';ctx.shadowBlur=8;ctx.stroke();ctx.shadowBlur=0;
if(idx<160){ctx.setLineDash([8,8]);ctx.beginPath();ctx.moveTo(cur.x,cur.y);for(let i=idx+1;i<pts.length;i++)ctx.lineTo(pts[i].x,pts[i].y);ctx.strokeStyle='rgba(127,248,194,.85)';ctx.lineWidth=2;ctx.stroke();ctx.setLineDash([])}ctx.beginPath();ctx.arc(cur.x,cur.y,8,0,Math.PI*2);ctx.fillStyle='#fff';ctx.shadowColor='#40efac';ctx.shadowBlur=13;ctx.fill();ctx.shadowBlur=0;
}
function render(){let info=calc(nowZoned());last=info;let st=info.status;$('status').textContent=st;$('status').style.color=st==='工作中'?'#90ffc1':st==='午休中'?'#ffdcaa':'#c9d4e4';$('countdown').textContent=info.cd>=86400?`${Math.floor(info.cd/86400)}天 ${hms(info.cd%86400)}`:hms(info.cd);$('countdown').style.fontSize=info.cd>=86400?'69px':'101px';$('date').textContent=`${info.now.getFullYear()}/${pad(info.now.getMonth()+1)}/${pad(info.now.getDate())}`;$('workTime').textContent=`${cfg.start} - ${cfg.end}`;$('breakTime').textContent=`${cfg.lunchStart} - ${cfg.lunchEnd}`;updateRing(info.ratio);$('percent').textContent=`${Math.round(info.ratio*100)}%`;$('earned').textContent=numberMoney(info.earned);$('daily').textContent=numberMoney(info.daily);$('progress').textContent=`${Math.round(info.ratio*100)}%`;$('hourly').textContent=numberMoney(info.hourly);$('worked').textContent=hms(info.sec);$('remaining').textContent=hms(Math.max(0,info.paidTotal-info.sec));$('chartChip').textContent=`当前：${numberMoney(info.earned)}`;$('monthCount').textContent=`${info.completed} 天`;$('monthWork').textContent=`${info.days.length} 天`;$('monthEarned').textContent=numberMoney(info.monthly);$('monthlyNet').textContent=numberMoney(cfg.monthlyNet);$('insurance').textContent=numberMoney(cfg.insurance);plot(info);if($('miniStatus')){let label=info.status==='休息中'?'休息中':info.status;$('miniStatus').textContent=label;$('miniTimer').textContent=info.cd>=86400?Math.floor(info.cd/86400)+'天 '+hms(info.cd%86400):hms(info.cd);$('miniMoney').textContent=numberMoney(info.earned);$('miniBar').style.width=Math.round(info.ratio*100)+'%';$('miniPct').textContent=Math.round(info.ratio*100)+'%';document.querySelector('.mini-foot span').textContent=`上班 ${cfg.start} · 下班 ${cfg.end}`} }
function resize(){let d=window.salaryApp,ww=window.innerWidth,hh=window.innerHeight,scale,x,y,w,h;if(d){let ref=compact?{x:158,y:47,w:1078,h:418}:{x:158,y:47,w:1078,h:1058};scale=Math.min(ww/ref.w,hh/ref.h);x=-ref.x*scale;y=-ref.y*scale;w=ref.w*scale;h=ref.h*scale}else{scale=Math.min(1,ww/1254,hh/1254);x=0;y=0;w=1254*scale;h=1254*scale}let vp=$('viewport');vp.style.left=d?'0px':`${Math.max(0,(ww-w)/2)}px`;vp.style.top=d?'0px':`${Math.max(0,(hh-h)/2)}px`;vp.style.width=w+'px';vp.style.height=h+'px';$('stage').style.transform=`translate(${x}px,${y}px) scale(${scale})`;}
function toast(msg){let e=$('toast');e.textContent=msg;e.classList.add('on');clearTimeout(toastTimer);toastTimer=setTimeout(()=>e.classList.remove('on'),3200)}
const DAYS=['日','一','二','三','四','五','六'];for(let i=0;i<7;i++){let label=document.createElement('label');let el=document.createElement('input');el.type='checkbox';el.value=i;el.className='weekday';label.append(el,document.createTextNode(' 周'+DAYS[i]));$('weekChecks').appendChild(label)}
function formFill(){let map={setNet:'monthlyNet',setInsurance:'insurance',setMethod:'salaryMode',setTimezone:'timezone',setStart:'start',setEnd:'end',setLunchStart:'lunchStart',setLunchEnd:'lunchEnd'};for(let id in map)$(id).value=cfg[map[id]];$('setPaidLunch').checked=cfg.paidLunch;$('setPinned').checked=cfg.alwaysOnTop;$('setAutoStart').checked=cfg.autoStart;document.querySelectorAll('.weekday').forEach(i=>i.checked=cfg.workDays.includes(+i.value));$('extraWork').value=cfg.extraWorkdays.join('\n');$('extraOff').value=cfg.extraHolidays.join('\n')}
function openModal(){formFill();$('modal').classList.add('show')}function closeModal(){$('modal').classList.remove('show')}
async function saveConfig(){let v={...cfg,monthlyNet:+$('setNet').value,insurance:+$('setInsurance').value,salaryMode:$('setMethod').value,timezone:$('setTimezone').value,start:$('setStart').value,end:$('setEnd').value,lunchStart:$('setLunchStart').value,lunchEnd:$('setLunchEnd').value,paidLunch:$('setPaidLunch').checked,alwaysOnTop:$('setPinned').checked,autoStart:$('setAutoStart').checked,workDays:[...document.querySelectorAll('.weekday:checked')].map(x=>+x.value),extraWorkdays:listDate($('extraWork').value),extraHolidays:listDate($('extraOff').value)};let s=toMin(v.start),e=toMin(v.end),a=toMin(v.lunchStart),b=toMin(v.lunchEnd);if(!(s<a&&a<b&&b<e)){toast('请保持：上班 < 午休开始 < 午休结束 < 下班');return}if(!v.workDays.length){toast('至少要有一个每周工作日');return}if(!Number.isFinite(v.monthlyNet)||v.monthlyNet<0||!Number.isFinite(v.insurance)||v.insurance<0){toast('工资金额不合法');return}cfg=merge(v);try{if(window.salaryApp){await window.salaryApp.saveConfig(cfg);await window.salaryApp.setAlwaysOnTop(cfg.alwaysOnTop);await window.salaryApp.setLoginItem(cfg.autoStart)}else localStorage.setItem('salary-widget-v2',JSON.stringify(cfg));toast('保存成功，计数已重新计算')}catch(e){toast('保存时发生错误：'+e.message)}closeModal();render()}
function exportSettings(){let a=document.createElement('a'),blob=new Blob([JSON.stringify(cfg,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob);a.href=url;a.download='工资计数器设置.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),500)}
function importSettings(f){if(!f)return;let reader=new FileReader();reader.onload=()=>{try{cfg=merge(JSON.parse(reader.result));formFill();toast('导入成功，点击保存并应用')}catch(e){toast('导入失败，JSON 格式不正确')}};reader.readAsText(f)}
function toggleExact(){exact=!exact;document.body.classList.toggle('reference-mode',exact);toast(exact?'已显示设计图原始像素 · 数据暂时隐藏':'返回实时工资模式')}
async function init(){document.body.classList.toggle('electron',!!window.salaryApp);let base=window.salaryApp?'data:image/png;base64,