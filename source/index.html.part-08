';if(window.salaryApp){window.salaryApp.onCompact(value=>{compact=!!value;document.body.classList.toggle('compact',compact);resize()});try{cfg=merge(await window.salaryApp.loadConfig())}catch(e){cfg=merge(null)}}else{try{cfg=merge(JSON.parse(localStorage.getItem('salary-widget-v2')||'null'))}catch(e){cfg=merge(null)}}const params=new URLSearchParams(location.search);if(params.get('compact')==='1'&&!window.salaryApp){compact=true;document.body.classList.add('compact')}if(params.get('demo'))window.__demoClock=params.get('demo')==='1'?'2026-11-20T14:42:00+08:00':params.get('demo');resize();render();setInterval(()=>{if(!exact)render()},1000)}

function moneyValue(n){return numberMoney(n)}
function showDetail(kind){
const info=last,now=info.now,ds=info.days,actual=info.monthly,each=info.daily;
let main=$('detailBody');if(kind==='salary'){
$('detailTitle').textContent='工资计算说明';$('detailSubtitle').textContent='逐秒计数 · 保留三位小数 · 可在设置中调整';
main.innerHTML=`<div class="detail-overview"><div class="detail-tile"><div class="tag">本月到手</div><div class="val">${moneyValue(cfg.monthlyNet)}</div></div><div class="detail-tile"><div class="tag">当日日薪</div><div class="val">${moneyValue(each)}</div></div><div class="detail-tile"><div class="tag">目前已获</div><div class="val">${moneyValue(info.earned)}</div></div></div><div class="detail-formula">日薪 = <strong>${moneyValue(cfg.monthlyNet)}</strong> ÷ <strong>${cfg.salaryMode==='month'?ds.length:'21.75'}</strong> 天 = <strong>${moneyValue(each)}</strong><br>有效工时 = <strong>${(info.paidTotal/3600).toFixed(2)} 小时/天</strong><br>每秒预计收入 = <strong>${moneyValue(each/info.paidTotal)}</strong><br>今日收入 = <strong>日薪 × 已经过的有效秒数 / 全日有效秒数</strong><br>五险一金 <strong>${moneyValue(cfg.insurance)}</strong> 为单独展示，不会从到手金额重复扣除。</div><p class="detail-note">这是按月薪和约定出勤时间估算的收入进度，并不是工资到账记录。休息日收入不会额外叠加，月末估算值取决于计薪方式。</p>`;
}else{
$('detailTitle').textContent=`${now.getFullYear()}年${now.getMonth()+1}月 · 收入日历`;$('detailSubtitle').textContent='每个工作日按当前设置自动折算，今天显示实时累计';
let tiles=`<div class="detail-overview"><div class="detail-tile"><div class="tag">本月预计到手</div><div class="val">${moneyValue(cfg.monthlyNet)}</div></div><div class="detail-tile"><div class="tag">本月已获得</div><div class="val">${moneyValue(actual)}</div></div><div class="detail-tile"><div class="tag">应出勤天数</div><div class="val">${ds.length} 天</div></div></div>`;
let y=now.getFullYear(),m=now.getMonth(),first=new Date(y,m,1),max=new Date(y,m+1,0).getDate(),html='<div class="detail-calendar">';
for(let i=0;i<7;i++)html+='<div class="weekday-title">'+['日','一','二','三','四','五','六'][i]+'</div>';
for(let i=0;i<first.getDay();i++)html+='<div aria-hidden="true"></div>';
for(let day=1;day<=max;day++){let d=new Date(y,m,day),wk=workday(d),today=key(d)===key(now),completed=key(d)<key(now),value=wk?(completed?each:today?info.earned:0):0,off=wk?'工作日':'休息日';html+=`<div class="detail-day ${wk?'working':'rest'} ${today?'today':''}" title="${off}${today?' · 今日':''}"><strong>${day}</strong><span class="amount">${wk?(completed||today?moneyValue(value):'待累计'):'休'}</span></div>`}
html+='</div><p class="detail-note">绿色标记为工作日；加亮边框代表今天。调休日期由内置日历和自定义数据共同判定。尚未到来的工作日显示“待累计”，不计入本月已获得金额。月度明细使用当前设置估算，不代表已发放工资。</p>';
main.innerHTML=tiles+html;
}
$('detailPanel').classList.add('show');
}
function hideDetail(){$('detailPanel').classList.remove('show')}

$('detailDismiss').onclick=hideDetail;
$('gear').onclick=openModal;$('dismiss').onclick=closeModal;$('cancel').onclick=closeModal;$('save').onclick=saveConfig;$('export').onclick=exportSettings;$('import').onclick=()=>$('fileImport').click();$('fileImport').onchange=e=>importSettings(e.target.files[0]);$('reset').onclick=()=>{if(confirm('恢复默认的工资、工时和休息日设置？')){cfg=merge(null);formFill();toast('已填写默认值，请点击保存并应用')}};
$('pin').onclick=async()=>{cfg.alwaysOnTop=!cfg.alwaysOnTop;if(window.salaryApp){await window.salaryApp.setAlwaysOnTop(cfg.alwaysOnTop);await window.salaryApp.saveConfig(cfg)}else localStorage.setItem('salary-widget-v2',JSON.stringify(cfg));toast(cfg.alwaysOnTop?'已开启置顶':'已关闭置顶')};
$('minus').onclick=async()=>{if(window.salaryApp){await window.salaryApp.setCompact(!compact);toast(compact?'已切换小组件模式，双击顶部或从托盘恢复':'已恢复完整面板')}else toast('桌面版支持悬浮收起；浏览器版不支持系统级缩放')};
$('quit').onclick=()=>{if(window.salaryApp)window.salaryApp.hide();else toast('浏览器预览：请关闭本标签页')};$('salaryClick').onclick=()=>showDetail('salary');$('monthClick').onclick=()=>showDetail('month');$('previewMode').onclick=toggleExact;
$('miniExpand').onclick=async()=>{if(window.salaryApp){await window.salaryApp.setCompact(false)}else{document.body.classList.remove('compact');resize()}};
$('miniClose').onclick=()=>{if(window.salaryApp)window.salaryApp.hide();else document.body.classList.remove('compact')};
$('miniPin').onclick=()=>$('pin').click();
window.addEventListener('keydown',e=>{if(e.altKey&&e.key.toLowerCase()==='r'){e.preventDefault();toggleExact()}if(e.key==='Escape'){closeModal();hideDetail()}});window.addEventListener('resize',resize);document.addEventListener('dblclick',e=>{if(!window.salaryApp)return;if(e.clientY<100&&!$('modal').classList.contains('show'))$('minus').click()});init();
</script></body></html>