{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "下班工资计数器",
  "version": "3.1.5",
  "identifier": "com.joeve.salarycounter",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "下班工资计数器",
        "width": 520,
        "height": 524,
        "visible": false,
        "center": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "shadow": false,
        "backgroundColor": "#00000000",
        "focus": false
      },
      {
        "label": "settings",
        "title": "个性化设置 · 下班工资计数器",
        "url": "settings.html",
        "width": 560,
        "height": 620,
        "visible": false,
        "center": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "closable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "backgroundColor": "#101827",
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "固定在桌面右上角的实时工资计数器",
    "longDescription": "一个轻量、固定位置的桌面工资计数器组件。",
    "icon": [
      "../assets/icon.png",
      "../assets/icon.ico",
      "../assets/icon.icns"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": false
    }
  }
}
